{% if todayBirthdays.birthdays.length %}
  <div class="birthday-message">
    <h2>🎉 Happy Birthday!</h2>
    <ul>
      {% for person in todayBirthdays.birthdays %}
        <li><strong>{{ person.name }}</strong></li>
      {% endfor %}
    </ul>
    <p>Wishing you all the best on your special day!</p>
  </div>
{% endif %}
